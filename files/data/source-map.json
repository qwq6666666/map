{
  "alwaysInclude": [
    "sinica"
  ],
  "alwaysIncludeUnless": [
    {
      "sources": [
        "ccts"
      ],
      "excludeIfIncludes": [
        "台灣", "臺灣", "Taiwan",
        "基隆",
        "臺北市", "台北市",
        "新北",
        "桃園",
        "新竹",
        "苗栗",
        "臺中", "台中",
        "彰化",
        "嘉義",
        "臺南", "台南",
        "高雄",
        "屏東",
        "宜蘭",
        "花蓮",
        "金門"
      ],
      "note": "中華文明之時空基礎架構(ccts)涵蓋全中國，不屬於任何單一縣市；規則是「只要地址不是台灣本島／外島的縣市，就一律列入候選」，所以用排除清單而非比對清單：排除清單就是全部既有的台灣縣市關鍵字（沿用 rules 裡各條台灣規則的 includes，另外加上通用的「台灣」「臺灣」「Taiwan」字樣）。"
    }
  ],
  "rules": [
    {
      "match": "county+district",
      "includes": [
        "基隆"
      ],
      "sources": [
        "keelung"
      ]
    },
    {
      "match": "county",
      "includes": [
        "臺北市",
        "台北市"
      ],
      "sources": [
        "taipei",
        "udd"
      ]
    },
    {
      "match": "county",
      "includes": [
        "新北"
      ],
      "sources": [
        "newtaipei"
      ],
      "districtRule": {
        "includes": [
          "新店",
          "石碇",
          "坪林",
          "烏來",
          "深坑"
        ],
        "sources": [
          "thm"
        ],
        "note": "深坑廳文山堡（青潭、直潭、龜山、大坪林、安坑等庄）圖層收錄在桃竹苗舊地籍圖(thm)來源裡，但這些庄現今行政區劃屬於新北市新店/石碇/坪林一帶，不會被縣市規則篩到，故另外補上。"
      }
    },
    {
