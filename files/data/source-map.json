      ],
      "districtRule": {
        "includes": [
          "新店",
          "石碇",
          "坪林",
          "烏來",
          "深坑"
        ],
        "sources": [
          "thm"
        ],
        "note": "深坑廳文山堡（青潭、直潭、龜山、大坪林、安坑等庄）圖層收錄在桃竹苗舊地籍圖(thm)來源裡，但這些庄現今行政區劃屬於新北市新店/石碇/坪林一帶，不會被縣市規則篩到，故另外補上。"
      }
    },
